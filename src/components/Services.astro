---
import servicesData from '../data/services.json';

const { header, items } = servicesData;
const mainService = items[0];
const secondaryServices = items.slice(1);
---

<!-- 1. Aplicamos los fondos directamente a la etiqueta section -->
<section id="servicios" class="relative z-20 w-full bg-[rgb(var(--color-bg))] dark:bg-[rgb(var(--color-dark))] transition-colors duration-300">
  
  <!-- 2. Envolvemos el contenido en un div que mantiene tus medidas y paddings originales -->
  <div class="max-w-[1400px] mx-auto px-6 md:px-12 lg:px-16 py-12 md:py-16 text-[rgb(var(--color-text-main))] dark:text-[rgb(var(--color-bg))] min-h-fit">
    
    <!-- Encabezado (Diseño Dividido) -->
    <div class="flex flex-col md:flex-row md:justify-between md:items-end gap-6 mb-10 md:mb-12">
      
      <!-- Lado Izquierdo: Título -->
      <div class="flex flex-col text-left">
        <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.1]">
          {header.title.start} <br class="hidden sm:block" />
          <span class={`text-[rgb(var(--color-primary))] ${header.title.highlightStyle}`}>
            {header.title.highlight}
          </span>
          {header.title.end}
        </h2>
      </div>

      <!-- Lado Derecho: Tag Monoespaciado con Borde Lateral -->
      {header.tag && (
        <div class="text-right border-r-[3px] border-[rgb(var(--color-primary))] pr-4 py-1 mb-2 md:mb-4">
          <span class="font-mono text-[10px] md:text-xs tracking-[0.2em] text-[rgb(var(--color-text-muted))] uppercase font-semibold">
            {header.tag}
          </span>
        </div>
      )}

    </div>

    <!-- Grilla Bento Box Compacta -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 md:gap-5">
      
      <!-- Tarjeta Principal (Vertical) -->
      {mainService && (
        <div class="lg:col-span-5 flex flex-col bg-[rgb(var(--color-text-muted))/0.03] dark:bg-[rgb(var(--color-text-muted))/0.08] border border-[rgb(var(--color-text-muted))/0.15] hover:border-[rgb(var(--color-secondary))] rounded-sm p-3 group transition-colors duration-300">
          
          <div class="overflow-hidden rounded-sm w-full h-[180px] lg:h-[220px] mb-4">
            <img 
              src={mainService.image} 
              alt={mainService.title} 
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />
          </div>
          
          <div class="px-2 pb-2 flex-1 flex flex-col">
            <h3 class="font-display text-lg md:text-xl font-bold mb-2 text-[rgb(var(--color-primary))]">
              {mainService.title}
            </h3>
            <p class="font-sans text-[rgb(var(--color-text-muted))] text-xs md:text-sm leading-relaxed mb-5">
              {mainService.description}
            </p>
            
            <a href={mainService.url} class="mt-auto group/btn flex items-center justify-center gap-2 px-5 py-2 bg-[rgb(var(--color-primary))] text-[rgb(var(--color-bg))] font-sans text-xs font-medium rounded-sm transition-all duration-300 hover:scale-[1.02] shadow-[0_4px_15px_rgb(var(--color-primary))/0.3] hover:shadow-[0_4px_20px_rgb(var(--color-primary))/0.5] w-fit">
              <span>Ver detalles</span>
              <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>

        </div>
      )}

      <!-- Tarjetas Secundarias -->
      <div class="lg:col-span-7 flex flex-col gap-4 md:gap-5">
        {secondaryServices.map((service) => (
          <div class="flex flex-col sm:flex-row bg-[rgb(var(--color-text-muted))/0.03] dark:bg-[rgb(var(--color-text-muted))/0.08] border border-[rgb(var(--color-text-muted))/0.15] hover:border-[rgb(var(--color-secondary))] rounded-sm p-3 group h-full transition-colors duration-300">
            
            <div class="overflow-hidden rounded-sm w-full sm:w-[40%] md:w-[45%] h-[160px] sm:h-full min-h-[160px]">
              <img 
                src={service.image} 
                alt={service.title} 
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                loading="lazy"
              />
            </div>
            
            <div class="px-2 py-3 sm:px-5 flex-1 flex flex-col justify-center">
              <h3 class="font-display text-lg md:text-xl font-bold mb-2 text-[rgb(var(--color-primary))]">
                {service.title}
              </h3>
              <p class="font-sans text-[rgb(var(--color-text-muted))] text-xs md:text-sm leading-relaxed mb-5">
                {service.description}
              </p>
              
              <a href={service.url} class="mt-auto sm:mt-0 group/btn flex items-center justify-center gap-2 px-5 py-2 bg-[rgb(var(--color-primary))] text-[rgb(var(--color-bg))] font-sans text-xs font-medium rounded-sm transition-all duration-300 hover:scale-[1.02] shadow-[0_4px_15px_rgb(var(--color-primary))/0.3] hover:shadow-[0_4px_20px_rgb(var(--color-primary))/0.5] w-fit">
                <span>Ver detalles</span>
                <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
              </a>
            </div>

          </div>
        ))}
      </div>

    </div>
  </div>
</section>