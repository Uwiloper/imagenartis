---
import projectsData from '../data/projects.json';

// Pasamos los datos al cliente
const projectsJSON = JSON.stringify(projectsData);
---

<!-- Agregamos los fondos dinámicos y ajustamos el margen negativo para móviles -->
<section class="w-full h-[50vh] min-h-[450px] overflow-hidden relative z-0 -mt-24 bg-transparent">
    <div id="webgl-slider" class="w-full h-full cursor-grab active:cursor-grabbing select-none" data-projects={projectsJSON}> 
        <!-- El canvas de ThreeJS se inyectará aquí -->
  </div>
</section>

<script>
  import * as THREE from 'three';

  const container = document.getElementById('webgl-slider');
  
  if (container) {
    const projects = JSON.parse(container.dataset.projects || '[]');
    
    const scene = new THREE.Scene();
    // El fondo de la escena ThreeJS se mantiene transparente (alpha: true) 
    // para que se vea el fondo de Tailwind que pusimos en el <section>

    const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 2000);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    const carouselGroup = new THREE.Group();
    scene.add(carouselGroup);

    const textureLoader = new THREE.TextureLoader();
    
    // --- 1. CONFIGURACIÓN DINÁMICA DE TARJETAS (RESPONSIVE) ---
    const isMobile = window.innerWidth < 768;
    const cardHeight = isMobile ? 170 : 220; 
    const cardWidth = isMobile ? 260 : 350;  
    const gap = 0;                                                               
    
    let multiplier = 1;
    while (projects.length * multiplier < 10) {
      multiplier++;
    }
    const totalCards = projects.length * multiplier; 

    // --- 2. CÁLCULO DEL RADIO MATEMÁTICO ---
    const circumference = totalCards * (cardWidth + gap);
    // Reducimos el radio mínimo en móviles para que la curva se note mejor
    const minRadius = isMobile ? 400 : 600;
    const radius = Math.max(minRadius, circumference / (Math.PI * 2)); 

    const anglePerCard = cardWidth / radius; 
    const angleStep = (Math.PI * 2) / totalCards; 

    // --- 3. POSICIÓN RELATIVA DE LA CÁMARA ---
    // Acercamos un poco más la cámara en móviles para que las tarjetas destaquen
    const distanceToCards = isMobile ? 550 : 650; 
    
    camera.position.set(radius - distanceToCards, 0, 0); 
    camera.lookAt(new THREE.Vector3(radius, 0, 0));

    // Creamos las tarjetas
    for (let i = 0; i < totalCards; i++) {
      const project = projects[i % projects.length];
      
      const geometry = new THREE.CylinderGeometry(
        radius, radius, cardHeight, 32, 1, true, -anglePerCard / 2, anglePerCard
      );

      const material = new THREE.MeshBasicMaterial({ 
        color: 0xffffff,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: 0.95
      });

      textureLoader.load(project.image, (texture) => {
        texture.generateMipmaps = true;
        texture.minFilter = THREE.LinearMipmapLinearFilter;
        texture.wrapS = THREE.RepeatWrapping;
        texture.repeat.x = -1; // Espejar para leer textos
        
        material.map = texture;
        material.needsUpdate = true;
      });

      const mesh = new THREE.Mesh(geometry, material);
      const currentAngle = i * angleStep;
      mesh.rotation.y = currentAngle;
      
      carouselGroup.add(mesh);
    }

    // --- INTERACCIÓN Y FÍSICAS ---
    let isDragging = false;
    let startX = 0;
    let currentRotation = 0;
    let targetRotation = 0;
    let velocity = 0;
    let autoRotateSpeed = 0.001;                                                

    container.addEventListener('mousedown', (e) => {
      isDragging = true;
      startX = e.clientX;
      velocity = 0;
    });

    window.addEventListener('mouseup', () => { isDragging = false; });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const deltaX = e.clientX - startX;
      startX = e.clientX;
      velocity = deltaX * 0.0015;                                               
      targetRotation += velocity;
    });

    // Soporte Táctil
    container.addEventListener('touchstart', (e) => {
      isDragging = true;
      startX = e.touches[0].clientX;
      velocity = 0;
    }, { passive: true });

    window.addEventListener('touchend', () => { isDragging = false; });

    window.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      const deltaX = e.touches[0].clientX - startX;
      startX = e.touches[0].clientX;
      velocity = deltaX * 0.002;
      targetRotation += velocity;
    }, { passive: true });


    // --- BUCLE DE ANIMACIÓN ---
    const animate = () => {
      requestAnimationFrame(animate);

      if (!isDragging) {
        if (Math.abs(velocity) > 0.0001) {
          velocity *= 0.95; 
          targetRotation += velocity;
        } else {
          targetRotation += autoRotateSpeed;
        }
      }

      currentRotation += (targetRotation - currentRotation) * 0.1;
      carouselGroup.rotation.y = currentRotation;
      carouselGroup.rotation.z = Math.sin(currentRotation * 2) * 0.02;

      renderer.render(scene, camera);
    };

    animate();

    window.addEventListener('resize', () => {
      // Recalcular responsividad en caso de giro de pantalla en móviles
      camera.aspect = container.clientWidth / container.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(container.clientWidth, container.clientHeight);
    });
  }
</script>