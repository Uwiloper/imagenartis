---
interface Props {
  titleStatic?: string;
  titleHighlight?: string;
  bgImage?: string;
  bgVideo?: string;
}

const {
  titleStatic = "Materializamos la identidad visual de tu marca con",
  titleHighlight = "precisión y maestría técnica",
  bgImage = "https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=1920&q=80",
  bgVideo = "/videos/fondo-hero.mp4"
} = Astro.props;
---

<section class="relative w-full overflow-hidden">
  
  <!-- HERO VISUAL: SOLO TÍTULO DE IMPACTO (Sin badge, sin descripción, sin botones) -->
  <div class="relative w-full h-[55vh] sm:h-[62vh] md:h-[68vh] min-h-[420px] max-h-[620px] flex items-center overflow-hidden">
    
    <!-- FONDO: VIDEO TÉCNICO O FOTO INDUSTRIAL CINEMATOGRÁFICA -->
    {bgVideo ? (
      <video
        autoplay
        loop
        muted
        playsinline
        class="absolute inset-0 w-full h-full object-cover object-center z-0 pointer-events-none"
      >
        <source src={bgVideo} type="video/mp4" />
      </video>
    ) : (
      <img
        src={bgImage}
        alt="Taller de Producción Gráfica, Wrapping y Branding - Imagen Artis"
        class="absolute inset-0 w-full h-full object-cover object-center z-0 transition-transform duration-1000 scale-[1.02]"
        loading="eager"
      />
    )}

    <!-- DEGRADADO CINEMATOGRÁFICO PARA LEGIBILIDAD -->
    <div class="absolute inset-0 bg-gradient-to-r from-black/95 via-black/85 to-black/55 md:via-black/75 md:to-transparent z-10 backdrop-blur-[0.5px]"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-transparent to-black/50 z-10 pointer-events-none"></div>

    <!-- CONTENIDO: ÚNICAMENTE EL TÍTULO -->
    <div class="relative z-20 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 sm:pt-28 md:pt-32 pb-8 flex flex-col justify-center">
      <div class="max-w-3xl text-left">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.5rem] font-display font-extrabold tracking-tight text-white leading-[1.08]">
          {titleStatic}{' '}
          <span class="text-[#EE2737] relative inline-block">
            {titleHighlight}
          </span>
        </h1>
      </div>
    </div>
  </div>

</section>
