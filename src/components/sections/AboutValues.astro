---
import { Target, Clock, Award, Users } from 'lucide-react';

const values = [
  {
    icon: Target,
    number: "01",
    title: "Rigor Técnico & Precisión",
    description: "Tolerancia cero a bordes descalzados, arrugas o empalmes improvisados. La excelencia en wrapping y letreros 3D radica en los remates que nadie más cuida."
  },
  {
    icon: Clock,
    number: "02",
    title: "Compromiso & Puntualidad",
    description: "Las fechas de entrega son pactos sagrados. Si coordinamos la salida de tus vehículos o la apertura de tu local para una fecha, el cronograma se cumple."
  },
  {
    icon: Award,
    number: "03",
    title: "Materiales Genuinos sin Trucos",
    description: "Ética total en sustratos y tintas. Jamás sustituimos vinilo fundido por calandrado genérico. Entregamos las fichas técnicas y certificados oficiales del fabricante."
  },
  {
    icon: Users,
    number: "04",
    title: "Trato Técnico Directo",
    description: "Sin 'ejecutivos de maletín' que desconocen de procesos. En Imagen Artis dialogas directamente con los ingenieros y maestros de taller que producen tu proyecto."
  }
];
---

<section class="relative w-full bg-white dark:bg-zinc-950 text-zinc-900 dark:text-white py-16 sm:py-20 md:py-24 border-b border-zinc-200 dark:border-zinc-800 transition-colors duration-300">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- ENCABEZADO DE SECCIÓN -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      
      <!-- BADGE -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-xs bg-[#EE2737]/10 text-[#EE2737] border border-[#EE2737]/25 text-xs font-mono font-bold uppercase tracking-widest mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-[#EE2737]"></span>
        <span>CÓDIGO DE TRABAJO</span>
      </div>

      <!-- TÍTULO -->
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-extrabold tracking-tight text-zinc-950 dark:text-white leading-tight mb-4">
        Nuestros valores: <span class="text-[#EE2737]">los 4 pilares innegociables</span>
      </h2>

      <!-- SUBTÍTULO -->
      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 font-sans leading-relaxed">
        No creemos en atajos ni en soluciones temporales. Estos son los principios que rigen cada corte, cada metro de vinil instalado y cada letrero que sale de nuestro taller.
      </p>

    </div>

    <!-- GRILLA DE 4 VALORES (TARJETAS COMPACTAS CON ICONO PURO) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {values.map((val) => {
        const Icon = val.icon;
        return (
          <div class="group relative p-6 sm:p-7 rounded-sm bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800/80 hover:border-zinc-400 dark:hover:border-zinc-600 transition-all duration-300 flex flex-col justify-between shadow-none">
            
            <div>
              <!-- FILA SUPERIOR: ICONO PURO (SIN BORDE NI FONDO) Y NÚMERO -->
              <div class="flex items-center justify-between mb-5">
                <div class="text-[#EE2737] transition-transform duration-300 group-hover:scale-110">
                  <Icon size={26} stroke-width={2} />
                </div>
                <span class="font-mono text-xs font-bold text-zinc-400 dark:text-zinc-600 group-hover:text-[#EE2737] transition-colors">
                  {val.number}
                </span>
              </div>

              <!-- TÍTULO -->
              <h3 class="text-base sm:text-lg font-display font-bold text-zinc-950 dark:text-white group-hover:text-[#EE2737] transition-colors leading-snug mb-3">
                {val.title}
              </h3>

              <!-- DESCRIPCIÓN CONCISA -->
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 font-sans leading-relaxed">
                {val.description}
              </p>
            </div>

            <!-- DETALLE INFERIOR -->
            <div class="mt-6 pt-4 border-t border-zinc-200/80 dark:border-zinc-800/80 flex items-center justify-between text-[11px] font-mono text-zinc-400">
              <span>Garantía de marca</span>
              <span class="text-[#EE2737]">Estándar Artis</span>
            </div>

          </div>
        );
      })}
    </div>

  </div>

</section>
