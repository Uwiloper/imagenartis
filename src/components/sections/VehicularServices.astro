      galleryCategory: "polarizados-seguridad",
      galleryUrl: "/portafolio?categoria=polarizados-seguridad"
    }
  ]
} = Astro.props;
---

<section id="servicios-vehiculares" class="py-20 md:py-28 bg-zinc-50 dark:bg-zinc-950 transition-colors duration-300 border-t border-zinc-200 dark:border-zinc-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de Sección Proporcional (Flat, sin sombras) -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-14">
      {badge && (
        <div class="mb-3.5 inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-semibold tracking-wider uppercase bg-white dark:bg-zinc-900 text-zinc-900 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-800">
          <span class="w-1.5 h-1.5 rounded-full bg-[#EE2737]"></span>
          {badge}
        </div>
      )}

      <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold tracking-tight text-zinc-900 dark:text-white leading-[1.2]">
        {titleStatic} <span class="text-[#EE2737]">{titleHighlight}</span>
      </h2>

      {description && (
        <p class="mt-4 text-xs sm:text-sm md:text-base text-zinc-600 dark:text-zinc-400 font-sans leading-relaxed max-w-2xl mx-auto">
          {description}
        </p>
      )}
    </div>

    <!-- Barra de Pestañas / Selector de Líneas Especializadas (Flat, responsive, esquinas poco redondeadas) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-3 mb-8 sm:mb-10" id="services-tabs-container">
      {services.map((service, index) => (
        <button
          type="button"
          data-tab-index={index}
          class={`service-tab-btn group text-left p-3.5 sm:p-4 rounded-md border transition-all duration-200 select-none cursor-pointer ${
            index === 0
              ? "active bg-white dark:bg-zinc-900 border-[#EE2737] text-zinc-900 dark:text-white"
              : "bg-white/70 dark:bg-zinc-900/60 border-zinc-200 dark:border-zinc-800 text-zinc-600 dark:text-zinc-400 hover:border-zinc-300 dark:hover:border-zinc-700"
          }`}
        >
          <div class="flex items-center justify-between mb-1.5">
            <span class="tab-number text-[11px] font-mono font-bold tracking-wider text-[#EE2737]">
              {service.tabNumber}
            </span>
            <span class="tab-tag hidden sm:inline-block text-[10px] font-mono uppercase px-2 py-0.5 rounded-sm bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400">
              {service.tag.split("/")[0].trim()}
            </span>
          </div>
          <span class="tab-title block text-xs sm:text-sm font-display font-bold tracking-tight text-zinc-900 dark:text-white line-clamp-1">
            {service.title.replace("Vinil ", "").replace("Protección ", "")}
          </span>
        </button>
      ))}
    </div>

    <!-- Escenario Principal del Servicio Activo (Layout 2 columnas amplio, editorial y limpio) -->
    <div class="w-full bg-white dark:bg-zinc-900 rounded-md border border-zinc-200 dark:border-zinc-800 overflow-hidden">
      {services.map((service, index) => (
        <div
          id={`service-panel-${index}`}
          class={`service-panel ${index === 0 ? "block" : "hidden"} transition-opacity duration-300`}
        >
          <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch">
            
            <!-- Columna Izquierda: Información Técnica y Especificaciones -->
            <div class="lg:col-span-7 p-6 sm:p-8 md:p-10 flex flex-col justify-between">
              <div>
                
                <!-- Tag Superior con Pulso -->
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 text-zinc-800 dark:text-zinc-200 text-[11px] font-mono font-semibold uppercase tracking-wider mb-4">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#EE2737]"></span>
                  <span>{service.tag}</span>
                </div>

                <h3 class="text-xl sm:text-2xl md:text-3xl font-display font-bold text-zinc-900 dark:text-white tracking-tight mb-2">
                  {service.title}
                </h3>
                
                <p class="text-xs sm:text-sm text-[#EE2737] font-sans font-medium mb-4">
                  {service.subtitle}
                </p>

                <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 font-sans leading-relaxed mb-6">
                  {service.description}
                </p>

                <!-- Fila de Ficha Técnica (Píldoras Técnicas) -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3 py-4 mb-6 border-y border-zinc-100 dark:border-zinc-800">
                  {service.specs.map(spec => (
                    <div class="flex flex-col bg-zinc-50 dark:bg-zinc-800/50 p-2.5 rounded-sm border border-zinc-200/80 dark:border-zinc-800">
                      <span class="text-[10px] font-mono text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">
                        {spec.label}
                      </span>
                      <span class="text-xs font-bold font-sans text-zinc-900 dark:text-white mt-0.5 line-clamp-1">
                        {spec.value}
                      </span>
                    </div>
                  ))}
                </div>

                <!-- Lista de 3 Ventajas Clave -->
                <ul class="space-y-2.5 mb-8">
                  {service.features.map(f => (
                    <li class="flex items-start gap-2.5 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300 font-sans">
                      <span class="text-[#EE2737] font-bold shrink-0 mt-0.5 text-sm">✓</span>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>

              </div>

              <!-- Acciones Duales: Primario (WhatsApp) + Secundario (Galería Filtrada) -->
              <div class="pt-6 border-t border-zinc-100 dark:border-zinc-800 flex flex-col sm:flex-row gap-3">
                <a
                  href={service.quoteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/btn flex-1 inline-flex items-center justify-center gap-2 py-3 px-6 rounded-sm bg-[#EE2737] hover:bg-[#d61e2e] text-white font-sans text-xs font-bold tracking-wider uppercase transition-all duration-200 select-none text-center shadow-none"
                >
                  <span>{service.quoteBtnText || "Cotizar Servicio"}</span>
                  <span class="transition-transform duration-200 group-hover/btn:translate-x-0.5">→</span>
                </a>

                <a
                  href={service.galleryUrl}
                  class="group/btn2 inline-flex items-center justify-center gap-2 py-3 px-6 rounded-sm border border-zinc-300 dark:border-zinc-700 hover:border-zinc-900 dark:hover:border-white text-zinc-800 dark:text-zinc-200 hover:text-zinc-950 dark:hover:text-white bg-transparent font-sans text-xs font-bold tracking-wider uppercase transition-all duration-200 select-none text-center shrink-0 shadow-none"
                >
                  <span>{service.galleryBtnText || "Ver Trabajos"}</span>
                  <span class="text-xs transition-transform duration-200 group-hover/btn2:translate-x-0.5">↗</span>
                </a>
              </div>

            </div>

            <!-- Columna Derecha: Fotografía de Alta Gama -->
            <div class="lg:col-span-5 relative bg-zinc-100 dark:bg-zinc-800 min-h-[280px] lg:min-h-full overflow-hidden border-t lg:border-t-0 lg:border-l border-zinc-200 dark:border-zinc-800">
              <img
                src={service.image}
                alt={service.imageAlt || service.title}
                loading="lazy"
                class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none"></div>
              
              <!-- Badge inferior con garantía en la foto -->
              <div class="absolute bottom-4 left-4 right-4 bg-black/75 backdrop-blur-xs p-3 rounded-sm border border-white/10 text-white flex items-center justify-between text-xs font-sans">
                <span class="font-bold">{service.title}</span>
                <span class="text-[11px] font-mono text-[#EE2737] uppercase font-semibold">Garantía Certificada</span>
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  // Script nativo ultra-ligero para alternar pestañas sin dependencias externas
  document.addEventListener("DOMContentLoaded", () => {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>(".service-tab-btn");
    const panels = document.querySelectorAll<HTMLDivElement>(".service-panel");

    tabButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const targetIndex = button.getAttribute("data-tab-index");
        if (targetIndex === null) return;

        // Actualizar estado visual de los botones de pestañas
        tabButtons.forEach((btn, idx) => {
          if (idx.toString() === targetIndex) {
            btn.classList.add("active", "border-[#EE2737]", "bg-white", "dark:bg-zinc-900", "text-zinc-900", "dark:text-white");
            btn.classList.remove("border-zinc-200", "dark:border-zinc-800", "text-zinc-600", "dark:text-zinc-400", "bg-white/70", "dark:bg-zinc-900/60");
          } else {
            btn.classList.remove("active", "border-[#EE2737]", "bg-white", "dark:bg-zinc-900", "text-zinc-900", "dark:text-white");
            btn.classList.add("border-zinc-200", "dark:border-zinc-800", "text-zinc-600", "dark:text-zinc-400", "bg-white/70", "dark:bg-zinc-900/60");
          }
        });

        // Mostrar el panel correspondiente
        panels.forEach((panel, idx) => {
          if (idx.toString() === targetIndex) {
            panel.classList.remove("hidden");
            panel.classList.add("block");
          } else {
            panel.classList.add("hidden");
            panel.classList.remove("block");
          }
        });
      });
    });
  });
</script>
