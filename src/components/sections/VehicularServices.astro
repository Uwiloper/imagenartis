      specs: [
        { label: "Rechazo Térmico", value: "Hasta 95% de calor infrarrojo (IR)" },
        { label: "Filtro Solar", value: "99% de protección rayos UV" },
        { label: "Grosor Seguridad", value: "Láminas de 8 a 12 micras certificadas" }
      ],
      features: [
        "Contención de fragmentos de vidrio ante impactos o rotura violenta",
