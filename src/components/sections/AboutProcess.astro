---
import { Scan, Palette, Printer, CheckCircle } from 'lucide-react';

const steps = [
  {
    number: "01",
    phase: "FASE INICIAL",
    title: "Diagnóstico & Medición Láser",
    description: "Evaluamos el estado de la carrocería, muro o fachada. Tomamos medidas milimétricas con distanciómetro láser y documentamos curvaturas y puntos de anclaje para evitar sorpresas.",
    bullets: ["Inspección de barniz y superficies", "Medición láser de alta precisión", "Briefing de requerimientos operativos"]
  },
  {
    number: "02",
    phase: "INGENIERÍA",
    title: "Preprensa & Calibración de Color",
    description: "Adaptamos el diseño al plano técnico a escala real. Calibramos los perfiles de color según la paleta corporativa y generamos un mockup 3D fotorealista para tu aprobación formal.",
    bullets: ["Maquetas a escala 1:1 y 1:10", "Pruebas de color físicas impresas", "Aprobación formal antes de producción"]
  },
  {
    number: "03",
    phase: "MANUFACTURA",
    title: "Producción en Taller Propio",
    description: "Imprimimos en plotters de tintas látex y UV resistentes a la intemperie. Aplicamos laminados de protección UV y procesamos cortes exactos mediante mesas digitales y router CNC.",
    bullets: ["Tintas ecológicas de larga duración", "Laminado UV anti-rayaduras", "Corte computarizado CNC y láser"]
  },
  {
    number: "04",
    phase: "INSTALACIÓN",
    title: "Aplicación Técnica & Garantía",
    description: "Nuestros instaladores certificados aplican el vinilo usando cintas de corte Knifeless para proteger la pintura. Sellamos bordes y post-calentamos a 95°C para una fijación permanente.",
    bullets: ["Técnicos certificados 3M y Avery", "Post-calentado para memoria elástica", "Entrega con certificado de garantía"]
  }
];
---

<section id="proceso" class="relative w-full bg-zinc-900 dark:bg-black text-white py-16 sm:py-20 md:py-24 border-b border-zinc-800 transition-colors duration-300">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- ENCABEZADO DE SECCIÓN -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      
      <!-- BADGE -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-xs bg-[#EE2737]/15 text-[#EE2737] border border-[#EE2737]/30 text-xs font-mono font-bold uppercase tracking-widest mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-[#EE2737]"></span>
        <span>MÉTODO DE PRODUCCIÓN</span>
      </div>

      <!-- TÍTULO -->
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-extrabold tracking-tight text-white leading-tight mb-4">
        Nuestro proceso: <span class="text-[#EE2737]">de la idea al espacio físico</span>
      </h2>

      <!-- SUBTÍTULO -->
      <p class="text-sm sm:text-base text-zinc-400 font-sans leading-relaxed">
        Un flujo estandarizado en 4 etapas que asegura máxima repetibilidad, exactitud cromática y cero improvisaciones durante el montaje.
      </p>

    </div>

    <!-- FLUJO PROGRESIVO DE 4 PASOS (LÍNEA DE TIEMPO EDITORIAL) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 relative">
      {steps.map((st, idx) => (
        <div class="group relative p-6 sm:p-7 rounded-sm bg-zinc-950/80 border border-zinc-800 hover:border-zinc-600 transition-all duration-300 flex flex-col justify-between">
          
          <div>
            <!-- ENCABEZADO DE PASO: NÚMERO ROJO Y FASE -->
            <div class="flex items-center justify-between mb-5 pb-3 border-b border-zinc-800/80">
              <span class="text-2xl sm:text-3xl font-display font-extrabold text-[#EE2737]">
                {st.number}
              </span>
              <span class="text-[10px] font-mono tracking-widest uppercase text-zinc-500 font-bold">
                {st.phase}
              </span>
            </div>

            <!-- TÍTULO DEL PASO -->
            <h3 class="text-base sm:text-lg font-display font-bold text-white group-hover:text-[#EE2737] transition-colors leading-snug mb-3">
              {st.title}
            </h3>

            <!-- DESCRIPCIÓN -->
            <p class="text-xs sm:text-sm text-zinc-400 font-sans leading-relaxed mb-5">
              {st.description}
            </p>

            <!-- CHECKLIST DE ACTIVIDADES TÉCNICAS -->
            <div class="space-y-1.5 pt-3 border-t border-zinc-800/60">
              {st.bullets.map(b => (
                <div class="flex items-start gap-2 text-xs font-sans text-zinc-300">
                  <span class="text-[#EE2737] font-bold shrink-0 mt-0.5">•</span>
                  <span>{b}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- INDICADOR DE CONTINUIDAD -->
          <div class="mt-6 pt-3 flex items-center justify-between text-[11px] font-mono text-zinc-500">
            <span>Paso {idx + 1} de 4</span>
            <span class="text-zinc-600 group-hover:text-zinc-400 transition-colors">Verificado ✓</span>
          </div>

        </div>
      ))}
    </div>

  </div>

</section>
