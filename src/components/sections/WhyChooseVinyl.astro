---
import { 
  Palette, 
  RotateCcw, 
  ShieldCheck, 
  CircleDollarSign, 
  BadgePercent, 
  Clock,
  Sparkles,
  CheckCircle2
} from 'lucide-react';

export interface WhyFeature {
  icon?: 'palette' | 'undo' | 'shield' | 'trending' | 'dollar' | 'clock' | 'sparkles' | 'check';
  title: string;
  description: string;
}

export interface Props {
  badge?: string;
  titleLine1?: string;
  titleLine2Static?: string;
  titleLine2Highlight?: string;
  features?: WhyFeature[];
  image?: string;
  imageAlt?: string;
  reverseLayout?: boolean;
}

const {
  badge,
  titleLine1 = '¿Por qué la gente',
  titleLine2Static = 'elige',
  titleLine2Highlight = 'vinil?',
  features = [
    {
      icon: 'palette',
      title: 'Colores, acabados y texturas ilimitados:',
      description: 'mate, satinado, fibra de carbono, cromo, cambio de color y mucho más.'
    },
    {
      icon: 'undo',
      title: 'Totalmente reversible:',
      description: 'se puede quitar en cualquier momento, la pintura original permanece intacta.'
    },
    {
      icon: 'shield',
      title: 'Protege la pintura original:',
      description: 'protege contra los rayos UV, las astillas, la sal y los arañazos.'
    },
    {
      icon: 'trending',
      title: 'Conserva el valor de reventa:',
      description: 'retírelo antes de venderlo, el coche parece recién salido de fábrica.'
    },
    {
      icon: 'dollar',
      title: 'Una fracción del costo de la pintura:',
      description: 'el mismo impacto a aproximadamente un tercio del precio.'
    },
    {
      icon: 'clock',
      title: 'Instalación en días, no en semanas:',
      description: 'la mayoría de los vinilos se instalan en 2-3 días.'
    }
  ],
  image = '/images/why-vinyl-car.png',
  imageAlt = 'Vehículo de lujo con wrap automotriz bitono de alta gama',
  reverseLayout = false,
} = Astro.props;
---

<section class="py-20 md:py-28 bg-white dark:bg-zinc-950 transition-colors duration-300 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class={`grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center ${reverseLayout ? 'lg:flex-row-reverse' : ''}`}>
      
      <!-- Columna Izquierda: Título y Lista de Beneficios -->
      <div class={`lg:col-span-7 flex flex-col justify-center ${reverseLayout ? 'lg:order-2' : 'lg:order-1'}`}>
        
        {badge && (
          <div class="mb-4">
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-semibold tracking-wider uppercase bg-zinc-100 text-zinc-900 dark:bg-zinc-900 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-800">
              <span class="w-1.5 h-1.5 rounded-full bg-[#EE2737]"></span>
              {badge}
            </span>
          </div>
        )}

        <!-- Título proporcionado (sin desbordes ni tamaño desmedido) -->
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold tracking-tight text-zinc-900 dark:text-white leading-[1.2] mb-6 sm:mb-8">
          {titleLine1} <br class="hidden sm:inline" />
          <span>{titleLine2Static}</span>{' '}
          <span class="text-[#EE2737]">{titleLine2Highlight}</span>
        </h2>

        <!-- Lista de 6 Beneficios -->
        <ul class="space-y-5 sm:space-y-6">
          {features.map((item) => (
            <li class="flex items-start gap-3.5 sm:gap-4 group">
              <!-- Icono circular con tono suave y contraste -->
              <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200/90 dark:border-zinc-800 flex items-center justify-center shrink-0 text-zinc-700 dark:text-zinc-300 group-hover:text-[#EE2737] group-hover:border-[#EE2737]/40 transition-all duration-300">
                {item.icon === 'palette' && <Palette size={18} strokeWidth={1.8} />}
                {item.icon === 'undo' && <RotateCcw size={17} strokeWidth={1.8} />}
                {item.icon === 'shield' && <ShieldCheck size={18} strokeWidth={1.8} />}
                {item.icon === 'trending' && <CircleDollarSign size={18} strokeWidth={1.8} />}
                {item.icon === 'dollar' && <BadgePercent size={18} strokeWidth={1.8} />}
                {item.icon === 'clock' && <Clock size={18} strokeWidth={1.8} />}
                {item.icon === 'sparkles' && <Sparkles size={18} strokeWidth={1.8} />}
                {item.icon === 'check' && <CheckCircle2 size={18} strokeWidth={1.8} />}
                {!item.icon && <CheckCircle2 size={18} strokeWidth={1.8} />}
              </div>

              <!-- Texto: Encabezado Negrita + Descripción -->
              <div class="text-xs sm:text-sm leading-relaxed text-zinc-600 dark:text-zinc-400 font-sans pt-0.5">
                <strong class="font-bold text-zinc-900 dark:text-white mr-1.5">
                  {item.title}
                </strong>
                <span>{item.description}</span>
              </div>
            </li>
          ))}
        </ul>

      </div>

      <!-- Columna Derecha: Tarjeta oscura SIN SOMBRAS (flat design) con fotografía de estudio -->
      <div class={`lg:col-span-5 ${reverseLayout ? 'lg:order-1' : 'lg:order-2'}`}>
        <div class="relative w-full aspect-[4/3] sm:aspect-[16/11] lg:aspect-[4/3] rounded-2xl overflow-hidden bg-black border border-zinc-200 dark:border-zinc-800/80 flex items-center justify-center group">
          
          <img
            src={image}
            alt={imageAlt}
            loading="lazy"
            class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
          />

          <!-- Sutil viñeta para contraste -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent pointer-events-none"></div>
          <div class="absolute inset-0 ring-1 ring-inset ring-white/10 rounded-2xl pointer-events-none"></div>

        </div>
      </div>

    </div>
  </div>
</section>
