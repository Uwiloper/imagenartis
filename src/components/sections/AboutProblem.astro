---
const risks = [
  {
    title: "Vinilos genéricos que dañan la pintura",
    description: "Materiales sin filtro UV que se cristalizan en meses, decoloran y al retirarse arrancan el barniz original dejando adhesivo abrasivo.",
    image: "https://images.unsplash.com/photo-1549399542-7e3f8b79c341?auto=format&fit=crop&w=800&q=80"
  },
  {
    title: "Intermediarios sin taller propio",
    description: "Revendedores 'de escritorio' que subcontratan a terceros no calificados, inflando los costos y deslindando responsabilidades ante fallas.",
    image: "https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=800&q=80"
  },
  {
    title: "Colores descalibrados y artes pixelados",
    description: "Cero perfilación técnica Fogra o Pantone. El resultado son letreros borrosos, contrastes pobres y tonos corporativos alterados.",
    image: "https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?auto=format&fit=crop&w=800&q=80"
  }
];
---

<section id="problema" class="relative w-full bg-zinc-950 text-white py-14 sm:py-16 md:py-20 border-b border-zinc-800 transition-colors duration-300">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- ENCABEZADO SIMPLIFICADO (Sin badge, texto breve e impactante) -->
    <div class="max-w-3xl mb-10 sm:mb-12">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-extrabold tracking-tight text-white leading-tight mb-3">
        El costo de la <span class="text-[#EE2737]">producción informal</span>
      </h2>
      <p class="text-sm sm:text-base text-zinc-400 font-sans leading-relaxed">
        Ahorrar en materiales dudosos o revendedores suele costar el doble en reparaciones, imagen dañada y tiempo perdido.
      </p>
    </div>

    <!-- 3 TARJETAS INTERACTIVAS CON FOTO (Sin numeración, sin iconos, sin tags de riesgo) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-7">
      {risks.map((risk) => (
        <div class="group relative rounded-md bg-zinc-900/90 border border-zinc-800 hover:border-zinc-600 overflow-hidden transition-all duration-300 flex flex-col shadow-none select-none">
          
          <!-- FOTO DEL RIESGO CON HOVER ZOOM INTERACTIVO -->
          <div class="relative w-full aspect-[16/10] overflow-hidden bg-black">
            <img
              src={risk.image}
              alt={risk.title}
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-900 via-transparent to-transparent opacity-80 pointer-events-none"></div>
          </div>

          <!-- CONTENIDO CONCISO -->
          <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="text-base sm:text-lg font-display font-bold text-white group-hover:text-[#EE2737] transition-colors leading-snug mb-2">
                {risk.title}
              </h3>
              <p class="text-xs sm:text-sm text-zinc-400 font-sans leading-relaxed">
                {risk.description}
              </p>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>

</section>
