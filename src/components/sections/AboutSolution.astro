---
import { Cpu, ShieldCheck, Warehouse } from 'lucide-react';

const solutions = [
  {
    icon: Cpu,
    title: "Ingeniería Gráfica & Preprensa",
    description: "Modelamos planos a escala real y calibramos perfiles de color Fogra y Pantone para que el tono en pantalla coincida exactamente con la impresión física."
  },
  {
    icon: ShieldCheck,
    title: "Materiales Genuinos Certificados",
    description: "Trabajamos con vinilos fundidos y láminas PPF de 3M, Avery Dennison y Arlon con respaldo oficial de fábrica contra decoloración y desprendimiento."
  },
  {
    icon: Warehouse,
    title: "Taller Propio & Montaje Técnico",
    description: "Bahías limpias y pistolas térmicas a 95°C para fijar la memoria elástica del vinil. Cero burbujas, cortes precisos y acabado sin empalmes visibles."
  }
];
---

<section id="solucion" class="relative w-full bg-zinc-50 dark:bg-zinc-900/60 text-zinc-900 dark:text-white py-14 sm:py-16 md:py-20 border-b border-zinc-200 dark:border-zinc-800 transition-colors duration-300">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- ENCABEZADO SIMPLIFICADO (Sin badge) -->
    <div class="max-w-3xl mb-10 sm:mb-12">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-extrabold tracking-tight text-zinc-950 dark:text-white leading-tight mb-3">
        Control total: <span class="text-[#EE2737]">del vector al montaje</span>
      </h2>
      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 font-sans leading-relaxed">
        Un solo equipo técnico se hace responsable de la conceptualización, preprensa, fabricación y montaje final de tu proyecto.
      </p>
    </div>

    <!-- 3 TARJETAS LIMPIAS (Sin números, sin checks, puro icono + título + texto breve) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-7">
      {solutions.map((sol) => {
        const Icon = sol.icon;
        return (
          <div class="group relative p-6 sm:p-7 rounded-sm bg-white dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800/90 hover:border-zinc-400 dark:hover:border-zinc-600 transition-all duration-300 flex flex-col justify-between shadow-none select-none">
            
            <div>
              <!-- ICONO PURO (Sin bordes, sin fondos, sin numeración) -->
              <div class="text-[#EE2737] mb-5 transition-transform duration-300 group-hover:scale-110">
                <Icon size={28} stroke-width={2} />
              </div>

              <!-- TÍTULO -->
              <h3 class="text-base sm:text-lg font-display font-bold text-zinc-950 dark:text-white group-hover:text-[#EE2737] transition-colors leading-snug mb-2">
                {sol.title}
              </h3>

              <!-- DESCRIPCIÓN CONCISA -->
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 font-sans leading-relaxed">
                {sol.description}
              </p>
            </div>

          </div>
        );
      })}
    </div>

  </div>

</section>
