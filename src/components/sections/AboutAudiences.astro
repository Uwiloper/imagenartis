---
import { Truck, Store, Sparkles, Building2, ArrowUpRight } from 'lucide-react';

const audiences = [
  {
    icon: Truck,
    badge: "B2B / TRANSPORTE",
    title: "Flotas Corporativas & Logística",
    subtitle: "Empresas con flotas de 1 a 100+ unidades",
    description: "Rotulado integral y parcial para furgones, camiones de carga y camionetas de supervisión minera. Utilizamos vinilos poliméricos y fundidos de alta resistencia para garantizar que tu marca ruede intacta durante años.",
    points: [
      "Instalación programada por lotes sin detener operaciones",
      "Cintas reflectivas certificadas según norma MTC",
      "Resistencia a lavado a presión y climas severos"
    ],
    ctaText: "Rotular Flota",
    ctaUrl: "https://wa.me/51994097417?text=¡Hola!%20Deseo%20cotizar%20rotulado%20para%20una%20flota%20corporativa"
  },
  {
    icon: Store,
    badge: "RETAIL & COMERCIO",
    title: "Locales Comerciales & Franquicias",
    subtitle: "Restaurantes, cafeterías, boutiques y cadenas",
    description: "Diseño y fabricación de fachadas en panel de aluminio compuesto (ACM), letreros corpóreos 3D retroiluminados, cajas de luz LED y vinilos decorativos de vitrina que elevan el ticket promedio de tu negocio.",
    points: [
      "Letreros 3D certificados para intemperie IP67",
      "Luz indirecta cálida o fría de alta visibilidad",
      "Vinil esmerilado con corte para privacidad y estética"
    ],
    ctaText: "Cotizar Fachada",
    ctaUrl: "https://wa.me/51994097417?text=¡Hola!%20Deseo%20cotizar%20un%20letrero%20o%20fachada%20comercial"
  },
  {
    icon: Sparkles,
    badge: "PARTICULARES & 4X4",
    title: "Propietarios & Entusiastas de Autos",
    subtitle: "Autos deportivos, pick-ups y todoterreno",
    description: "Transformación estética total (Color Change) y protección de pintura original con láminas PPF autorregenerables. Acabados mate, satinado, brillante o camuflado con desmontaje minucioso de piezas.",
    points: [
      "100% reversible sin dañar la pintura original",
      "PPF transparente contra impacto de gravilla",
      "Acabado estilo pintura original sin cortes en carrocería"
    ],
    ctaText: "Cotizar Wrap",
    ctaUrl: "https://wa.me/51994097417?text=¡Hola!%20Deseo%20cotizar%20un%20wrap%20o%20PPF%20para%20mi%20vehículo"
  },
  {
    icon: Building2,
    badge: "ALIANZAS CREATIVAS",
    title: "Agencias & Estudios de Arquitectura",
    subtitle: "Diseñadores, directores de arte y proyectistas",
    description: "Somos el socio técnico de confianza que traduce renders y planos de señalética en elementos físicos reales. Respetamos los códigos cromáticos y las especificaciones de materiales al milímetro.",
    points: [
      "Interpretación directa de planos CAD e Illustrator",
      "Pruebas de materiales y asesoría técnica de viabilidad",
      "Ejecución en obra con personal certificado SCTR"
    ],
    ctaText: "Alianza Técnica",
    ctaUrl: "https://wa.me/51994097417?text=¡Hola!%20Soy%20de%20una%20agencia/estudio%20y%20deseo%20coordinar%20un%20proyecto"
  }
];
---

<section class="relative w-full bg-white dark:bg-zinc-950 text-zinc-900 dark:text-white py-16 sm:py-20 md:py-24 border-b border-zinc-200 dark:border-zinc-800 transition-colors duration-300">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- ENCABEZADO DE SECCIÓN -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      
      <!-- BADGE -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-xs bg-[#EE2737]/10 text-[#EE2737] border border-[#EE2737]/25 text-xs font-mono font-bold uppercase tracking-widest mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-[#EE2737]"></span>
        <span>A QUIÉNES SERVIMOS</span>
      </div>

      <!-- TÍTULO -->
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-extrabold tracking-tight text-zinc-950 dark:text-white leading-tight mb-4">
        Soluciones especializadas <span class="text-[#EE2737]">para cada tipo de cliente</span>
      </h2>

      <!-- SUBTÍTULO -->
      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 font-sans leading-relaxed">
        Cada sector tiene requerimientos técnicos, tiempos y normativas distintas. Adaptamos nuestros procesos para darte la solución exacta que tu operación necesita.
      </p>

    </div>

    <!-- GRILLA DE AUDIENCIAS (4 TARJETAS BENTO CON TEXTO CONCISO E ICONO PURO) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {audiences.map((aud) => {
        const Icon = aud.icon;
        return (
          <div class="group relative p-7 sm:p-8 rounded-sm bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800/80 hover:border-zinc-400 dark:hover:border-zinc-600 transition-all duration-300 flex flex-col justify-between shadow-none">
            
            <div>
              <!-- FILA SUPERIOR: BADGE MONOSPACE E ICONO PURO -->
              <div class="flex items-center justify-between mb-5">
                <span class="px-2.5 py-1 rounded-xs bg-zinc-200/80 dark:bg-zinc-800 text-[10px] font-mono font-bold uppercase tracking-wider text-zinc-700 dark:text-zinc-300">
                  {aud.badge}
                </span>
                <div class="text-[#EE2737] transition-transform duration-300 group-hover:scale-110">
                  <Icon size={26} stroke-width={2} />
                </div>
              </div>

              <!-- TÍTULO Y SUBTÍTULO -->
              <h3 class="text-lg sm:text-xl font-display font-bold text-zinc-950 dark:text-white group-hover:text-[#EE2737] transition-colors leading-snug">
                {aud.title}
              </h3>
              <p class="text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-4">
                {aud.subtitle}
              </p>

              <!-- DESCRIPCIÓN -->
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 font-sans leading-relaxed mb-5">
                {aud.description}
              </p>

              <!-- CHECKLIST DE BENEFICIOS ESPECÍFICOS -->
              <div class="space-y-2 pt-4 border-t border-zinc-200/80 dark:border-zinc-800/80">
                {aud.points.map(pt => (
                  <div class="flex items-start gap-2 text-xs font-sans text-zinc-700 dark:text-zinc-300">
                    <span class="text-[#EE2737] font-bold shrink-0 mt-0.5">✓</span>
                    <span>{pt}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- ENLACE DE ACCIÓN DIRECTO -->
            <div class="mt-6 pt-4 border-t border-zinc-200/80 dark:border-zinc-800/80 flex items-center justify-between">
              <a
                href={aud.ctaUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-sans font-bold text-[#EE2737] hover:underline uppercase tracking-wider group-hover:translate-x-1 transition-transform"
              >
                <span>{aud.ctaText}</span>
                <ArrowUpRight size={14} />
              </a>
              <span class="text-[11px] font-mono text-zinc-400">Atención personalizada</span>
            </div>

          </div>
        );
      })}
    </div>

  </div>

</section>
