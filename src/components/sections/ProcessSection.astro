---
import { getProcesoData } from '../../lib/cms';

interface Props {
  data?: ReturnType<typeof getProcesoData>;
}

const { data } = Astro.props;
const proceso = data || getProcesoData();

// Garantizar exactamente 3 pasos limpios en la cuadrícula de 3 columnas
const rawSteps = proceso.steps || [];
const steps = rawSteps.length === 4
  ? [
      {
        ...rawSteps[0],
        title: 'Asesoría y Diseño',
        description: 'Evaluamos tu vehículo, fachada o espacio comercial y desarrollamos maquetaciones 3D milimétricas adaptadas a tu marca.',
        stepNumber: '01',
        timeBadge: 'Paso 01',
        linkText: 'Solicitar asesoría y diseño →',
        linkUrl: 'https://wa.me/51994097417?text=Hola,%20deseo%20iniciar%20un%20concepto%20de%20diseño%20para%20mi%20marca'
      },
      {
        ...rawSteps[2],
        stepNumber: '02',
        timeBadge: 'Paso 02',
        linkText: 'Ver materiales y acabados →',
        linkUrl: 'https://wa.me/51994097417?text=Hola,%20quisiera%20conocer%20los%20materiales%20y%20garantías%20de%20impresión'
      },
      {
        ...rawSteps[3],
        stepNumber: '03',
        timeBadge: 'Paso 03',
        linkText: 'Coordinar instalación →',
        linkUrl: 'https://wa.me/51994097417?text=Hola,%20deseo%20coordinar%20una%20fecha%20de%20instalación'
      }
    ]
  : rawSteps;
---

<section id="proceso" class="relative py-20 md:py-28 bg-white dark:bg-zinc-950 transition-colors duration-300 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header de Sección: Tamaño homogeneizado a text-3xl md:text-4xl font-display font-bold -->
    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-16">
      <h2 class="text-3xl md:text-4xl font-display font-bold tracking-tight text-center text-zinc-900 dark:text-white">
        {proceso.titleStatic}{' '}
        <span class="text-[#EE2737]">{proceso.titleHighlight}</span>
      </h2>

      {proceso.subtitle && (
        <p class="mt-4 text-sm sm:text-base text-zinc-600 dark:text-zinc-400 font-sans leading-relaxed">
          {proceso.subtitle}
        </p>
      )}
    </div>

    <!-- Barra de progreso con badges oscuros y línea conectora (sin sombras) -->
    <div class="relative mb-8 max-w-5xl mx-auto hidden sm:block">
      <div class="absolute top-1/2 left-8 right-8 -translate-y-1/2 h-[1px] bg-zinc-200 dark:bg-zinc-800 z-0"></div>
      <div class="relative z-10 grid grid-cols-3 gap-6 lg:gap-8">
        {steps.map((step, index) => {
          const badgeText = step.timeBadge || (step.stepNumber ? `Paso ${step.stepNumber}` : `Paso 0${index + 1}`);
          return (
            <div class="flex justify-center">
              <span class="inline-flex items-center px-4 py-1.5 rounded-full text-xs font-semibold tracking-wider uppercase bg-[#18181b] text-white dark:bg-zinc-800 dark:text-zinc-100 border border-zinc-700/50 shadow-sm">
                {badgeText}
              </span>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Grid de 3 Tarjetas (esquinas redondeadas a rounded-xl al igual que ShowcasePortfolio) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 max-w-5xl mx-auto">
      {steps.map((step) => (
        <article class="group relative flex flex-col bg-white dark:bg-zinc-900 rounded-xl overflow-hidden border border-zinc-200/90 dark:border-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors duration-200">
          
          <!-- Imagen del paso: Ocupa todo el ancho superior y laterales al ras -->
          <div class="relative aspect-[16/11] w-full overflow-hidden bg-zinc-100 dark:bg-zinc-800">
            <img
              src={step.image}
              alt={step.title}
              loading="lazy"
              class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
            />
          </div>

          <!-- Contenido textual interno con padding -->
          <div class="flex-1 flex flex-col justify-between p-5 sm:p-6">
            <div>
              <h3 class="text-lg sm:text-xl font-bold font-heading text-zinc-900 dark:text-white tracking-tight mb-2.5">
                {step.title}
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 font-sans leading-relaxed mb-6">
                {step.description}
              </p>
            </div>

            <!-- Enlace CTA rojo con flecha y línea divisoria sutil -->
            {step.linkText && (
              <div class="pt-4 border-t border-zinc-100 dark:border-zinc-800/60">
                <a
                  href={step.linkUrl || '#'}
                  target={step.linkUrl?.startsWith('http') ? '_blank' : '_self'}
                  rel={step.linkUrl?.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="group/link inline-flex items-center gap-1.5 text-sm font-semibold text-[#EE2737] hover:text-[#c41f2d] dark:text-[#ff3b4b] dark:hover:text-[#ff6b77] transition-colors"
                >
                  <span>{step.linkText.replace('→', '').trim()}</span>
                  <span class="inline-block transition-transform duration-200 group-hover/link:translate-x-1">→</span>
                </a>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
