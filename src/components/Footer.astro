    ---
// src/components/Footer.astro
import { getSiteSettings, getFooterData } from '../lib/cms';

const currentYear = new Date().getFullYear();
const siteSettings = getSiteSettings();
const footerData = getFooterData();
---

<footer class="bg-[#0a0a0a] border-t border-[#1a1a1a] pt-16 pb-8 relative z-10 overflow-hidden animate-fade-in-up">
  
  {/* --- EFECTO LÁSER / NEÓN --- */}
  <div class="absolute top-0 left-0 w-full h-[2px] bg-transparent overflow-hidden">
    <div class="h-full w-1/3 bg-gradient-to-r from-transparent via-[#EE2737] to-transparent animate-laser shadow-[0_0_15px_rgba(238,39,55,0.8)]"></div>
  </div>

  {/* --- MARCA DE AGUA (Logo Gigante de Fondo) --- */}
  <div class="absolute top-12 -left-20 md:-left-10 w-96 h-96 opacity-[0.03] pointer-events-none select-none z-0 transform -rotate-12">
    <img 
      src="/logo-horizontal.svg" 
      alt="Fondo Imagenartis" 
      class="w-full h-full object-contain"
    />
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-12">
      
      {/* Columna 1: Info Principal (Ahora con Logo integrado) */}
      <div class="md:col-span-4">
        <div class="flex items-center gap-3 mb-4">
          <img 
            src="/logo-horizontal.svg" 
            alt="Logo Imagenartis" 
            class="w-8 h-8 object-contain"
          />
          <span class="text-2xl font-heading font-bold text-white tracking-widest block">
            IMAGENARTIS
          </span>
        </div>
        <p class="text-gray-400 text-sm leading-relaxed mb-6 font-sans">
          {footerData.description}
        </p>
        <div class="inline-block bg-[#1a1a1a] border border-[#333333] px-4 py-2 rounded-sm text-xs text-gray-300 font-mono tracking-wider hover:border-[#EE2737] transition-colors duration-300">
          RUC: {siteSettings.ruc}
        </div>
      </div>

      {/* Columna 2: Servicios (Con subrayado suave) */}
      <div class="md:col-span-4 md:pl-10">
        <h3 class="text-white font-heading font-semibold mb-6 uppercase tracking-widest text-sm relative inline-block after:content-[''] after:absolute after:-bottom-2 after:left-0 after:w-8 after:h-0.5 after:bg-[#EE2737] after:rounded-full">
          Servicios
        </h3>
        <ul class="space-y-4 text-sm font-sans">
          {footerData.services.map((s) => (
            <li>
              <a href={s.href} class="text-gray-400 hover:text-[#EE2737] hover:translate-x-2 inline-block transition-all duration-300">
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Columna 3: Contacto (Con subrayado suave) */}
      <div class="md:col-span-4">
        <h3 class="text-white font-heading font-semibold mb-6 uppercase tracking-widest text-sm relative inline-block after:content-[''] after:absolute after:-bottom-2 after:left-0 after:w-8 after:h-0.5 after:bg-[#EE2737] after:rounded-full">
          Contacto & Taller
        </h3>
        <ul class="space-y-4 text-sm text-gray-400 font-sans">
          <li class="flex items-start gap-3 group">
            <svg class="w-5 h-5 text-[#EE2737] mt-0.5 shrink-0 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <span>{siteSettings.address}</span>
          </li>
          <li class="flex items-center gap-3 group">
            <svg class="w-5 h-5 text-[#EE2737] shrink-0 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            <span>{siteSettings.phone}</span>
          </li>
          <li class="flex items-center gap-3 group">
            <svg class="w-5 h-5 text-[#EE2737] shrink-0 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>{siteSettings.hours}</span>
          </li>
        </ul>
      </div>

    </div>

    {/* --- BOTTOM BAR (Legales y Copyright) --- */}
    <div class="border-t border-[#1a1a1a] pt-8 flex flex-col lg:flex-row justify-between items-center gap-6 text-xs text-gray-500 font-sans">
      
      <p>© {currentYear} {footerData.copyrightText}</p>
      
      <div class="flex flex-wrap justify-center gap-4">
        {footerData.legalLinks.map((l, i) => (
          <Fragment key={l.name}>
            <a href={l.href} class="hover:text-white transition-colors duration-300">{l.name}</a>
            {i < footerData.legalLinks.length - 1 && <span class="text-[#333] hidden sm:inline">|</span>}
          </Fragment>
        ))}
      </div>

      <p>Desarrollado con <span class="text-[#EE2737] animate-pulse inline-block">⚡</span> por Wilmer</p>
    </div>

  </div>

</footer>