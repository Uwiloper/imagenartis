---
import Layout from '../layouts/Layout.astro';
import HeroWrapAuto from '../components/sections/HeroWrapAuto.astro';
import WhyChooseVinyl from '../components/sections/WhyChooseVinyl.astro';
import VehicularServices from '../components/sections/VehicularServices';
import VehicleGalleryMarquee from '../components/sections/VehicleGalleryMarquee';
import EngagementCTA from '../components/sections/EngagementCTA.astro';
import ShowcasePortfolio from '../components/sections/ShowcasePortfolio';
import WaysToStart from '../components/sections/WaysToStart.astro';
import { fetchAllSections } from '../lib/cms';

const cms = await fetchAllSections();

// Proyectos automotrices antes y después para el showcase
const wrapAutoShowcaseItems = [
  {
    id: 'flota-comercial',
    category: 'Flota Comercial',
    beforeImage: 'https://images.unsplash.com/photo-1550355291-bbee04a92027?q=80&w=1200&auto=format&fit=crop',
    afterImage: 'https://images.unsplash.com/photo-1619682817481-e994891cd1f5?q=80&w=1200&auto=format&fit=crop',
    testimonial: '"Rotularon 12 unidades de nuestra flota corporativa en tiempo récord sin detener nuestra operación diaria."',
    clientName: 'Transportes & Logística del Pacífico'
  },
  {
    id: 'cambio-color',
    category: 'Cambio de Color',
    beforeImage: 'https://images.unsplash.com/photo-1503376780353-7e6692767b70?q=80&w=1200&auto=format&fit=crop',
    afterImage: 'https://images.unsplash.com/photo-1617788138017-80ad40651399?q=80&w=1200&auto=format&fit=crop',
    testimonial: '"El acabado satinado es impresionante, parece pintura de fábrica. La atención al detalle en los bordes es perfecta."',
    clientName: 'Alejandro V. - Porsche Cayman'
  },
  {
    id: 'ppf-proteccion',
    category: 'Protección PPF',
    beforeImage: 'https://images.unsplash.com/photo-1542282088-72c9c27ed0cd?q=80&w=1200&auto=format&fit=crop',
    afterImage: 'https://images.unsplash.com/photo-1618843479313-40f8afb4b4d8?q=80&w=1200&auto=format&fit=crop',
    testimonial: '"Instalé PPF completo en mi camioneta para viajes a provincia. Cero marcas de piedras y la pintura original está intacta."',
    clientName: 'Gonzalo M. - Toyota Hilux 4x4'
  }
];

const vehicleShowcase = (cms.showcase?.items || []).filter(item => 
  item.id === 'vehiculo' || item.category?.toLowerCase().includes('veh') || item.category?.toLowerCase().includes('flota')
);
const showcaseItems = vehicleShowcase.length > 1 ? vehicleShowcase : wrapAutoShowcaseItems;

const wrapSolutions = [
  {
    title: "Flotas Comerciales & Corporativas",
    tag: "B2B / Empresas",
    description: "Identidad homogénea y rotulación de alto impacto para furgonetas, camiones de reparto y flotas de ventas. Máxima visibilidad de marca en las calles.",
    features: [
      "Diseño adaptado a plantillas vehiculares exactas",
      "Instalación programada por lotes (sin detener tu operación)",
      "Laminado anti-rayones y resistente a lavado a presión"
    ],
    image: "https://images.unsplash.com/photo-1549399542-7e3f8b79c341?auto=format&fit=crop&w=800&q=80",
    cta: "Cotizar Flota Corporativa"
  },
  {
    title: "Cambio de Color & Personalización VIP",
    tag: "Estilo & Protección",
    description: "Renueva completamente la estética de tu vehículo particular o deportivo sin dañar la pintura original. Acabados mate, satinados, tornasol y fibra de carbono.",
    features: [
      "Paleta con más de 200 tonalidades 3M y Avery",
      "Desmontaje y montaje técnico de piezas sin cortes en carrocería",
      "Removible al 100% conservando el valor de reventa"
    ],
    image: "https://images.unsplash.com/photo-1617788138017-80ad40651399?auto=format&fit=crop&w=800&q=80",
    cta: "Ver Catálogo de Colores"
  },
  {
    title: "Protección PPF (Paint Protection Film)",
    tag: "Blindaje Transparente",
    description: "Película de uretano transparente de alta resistencia que absorbe impactos de piedras, gravilla e insectos en carretera. Propiedad auto-regenerativa con calor.",
    features: [
      "Capa autoreparable ante micro-rayas y arañazos",
      "Brillo hidrofóbico que repele agua, polvo y suciedad",
      "Hasta 10 años de garantía contra decoloración"
    ],
    image: "https://images.unsplash.com/photo-1618843479313-40f8afb4b4d8?auto=format&fit=crop&w=800&q=80",
    cta: "Consultar Protección PPF"
  }
];

const faqs = [
  {
    q: "¿El vinil wrap daña la pintura original de mi vehículo?",
    a: "No. Al contrario, el vinil fundido de calidad 3M y Avery Dennison actúa como un escudo protector contra la radiación UV, rasguños superficiales y salpicaduras. Al retirarse años después, la pintura de fábrica se conserva intacta."
  },
  {
    q: "¿Cuánto tiempo dura una rotulación vehicular?",
    a: "Dependiendo de la exposición solar y cuidados, nuestros viniles fundidos con laminación UV garantizan entre 3 y 7 años de durabilidad sin decolorarse ni despegarse en los bordes."
  },
  {
    q: "¿Cuánto tiempo toma el proceso de instalación?",
    a: "Para vehículos comerciales o cambio de color individual suele tardar entre 2 y 4 días hábiles. En flotas corporativas coordinamos cronogramas por lotes o turnos especiales para no interrumpir tu logística comercial."
  },
  {
    q: "¿Se puede lavar el vehículo normalmente después del wrap?",
    a: "Sí. Recomendamos lavado a mano o con manguera de presión moderada manteniendo al menos 30 cm de distancia de los bordes. Evitamos rodillos automáticos abrasivos."
  }
];
---

<Layout 
  title="Wrap Automotriz y Rotulación de Flotas en Lima | Imagenartis"
  description="Especialistas en rotulación vehicular, cambio de color y branding para flotas corporativas en Lima y todo el Perú. Vinilos 3M y Avery Dennison con garantía certificada."
>

  <!-- 1. HERO DEDICADO DE 80% VIEWPORT CON LOS 3 PRINCIPALES -->
  <HeroWrapAuto secondaryBtnUrl="#servicios-vehiculares" />

  <!-- 2. SECCIÓN: ¿POR QUÉ LA GENTE ELIGE VINIL? (6 BENEFICIOS + ESTUDIO FOTOGRÁFICO) -->
  <WhyChooseVinyl />

  <!-- 3. LÍNEAS ESPECIALIZADAS: LOS 5 TIPOS VEHICULARES CON MINI NAVBAR Y VIDEO EN BUCLE -->
  <VehicularServices client:visible />

  <!-- 4. NUEVO: CARRUSEL AUTOMÁTICO INFINITO ARRASTRABLE (MARQUEE DRAGGABLE) -->
  <VehicleGalleryMarquee client:visible />

  <!-- 5. CALL TO ACTION FINAL CON LIENZO INTERACTIVO Y CONTACTO DIRECTO -->
  <EngagementCTA />

  <!-- SECCIONES EN RESERVA (Ocultas visualmente para activación progresiva) -->
  {/* 
  <ShowcasePortfolio items={showcaseItems} client:visible />
  <WaysToStart />
  */}

</Layout>
