---
import { getAdminDashboardData } from '../lib/admin';
import AdminDashboard from '../components/admin/AdminDashboard';
import '../styles/global.css';

export const prerender = false;

const adminData = getAdminDashboardData();
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Imagenartis CMS | Panel de Administración</title>
    <link rel="icon" type="image/svg+xml" href="/logo-solo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700;800&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-zinc-950 text-white m-0 p-0 overflow-hidden font-sans">
    <AdminDashboard initialData={adminData} client:only="react" />
  </body>
</html>
